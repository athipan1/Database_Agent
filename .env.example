# PostgreSQL Database Configuration
# Local Docker uses the postgres provider and may create the configured database.
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=trading_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database provider: postgres or supabase
DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://trading_user:your_strong_password_here@db:5432/trading_db
DATABASE_SSL_MODE=prefer
DATABASE_CREATE_IF_MISSING=true
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=20
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Supabase primary example
# Use the server-side Session Pooler connection string from Supabase.
# Keep the database password only in Railway Variables or GitHub Secrets.
# DATABASE_PROVIDER=supabase
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<session-pooler-host>:5432/postgres
# DATABASE_SSL_MODE=require
# DATABASE_CREATE_IF_MISSING=false

# API Security Configuration
# Generate a secure key, e.g. with: openssl rand -hex 32
DATABASE_AGENT_API_KEY=

# Alpaca API Credentials
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
