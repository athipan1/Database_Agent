# PostgreSQL Database Configuration
# These variables are used by docker-compose.yml to set up the database container.
POSTGRES_USER=trading_user
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=trading_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Application Configuration
# This single URL is used by the application to connect to the primary database.
DATABASE_URL=postgresql://trading_user:your_strong_password_here@db:5432/trading_db

# API Security Configuration
# This key is required for the Database Agent to accept requests.
# Generate a secure key, e.g., using: openssl rand -hex 32
DATABASE_AGENT_API_KEY=

# Alpaca API Credentials
# These are required to fetch market data from Alpaca.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Optional Supabase asynchronous mirror
# Railway PostgreSQL remains the source of truth. Enable only after setting a
# server-side Supabase secret key. Never use a publishable/anon key here.
SUPABASE_REPLICATION_ENABLED=false
SUPABASE_URL=https://djolfrfrghhvwmpvtkpt.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_TABLE=database_agent_events
SUPABASE_REPLICATION_INTERVAL_SECONDS=10
SUPABASE_REPLICATION_BATCH_SIZE=50
SUPABASE_REPLICATION_MAX_ATTEMPTS=10
